# CampusFind 2.0 - Environment Configuration
# Copy this file to .env and adjust variables as per your local setup

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=campusfind_db
DB_PORT=3306

# JWT Authentication Secret & Expiration
JWT_SECRET=campusfind_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated list for local & production origins)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

